{
  "name": "@mykolapodpriatov/vue-composables-kit",
  "version": "0.1.0",
  "description": "Production-hardened Vue 3 composables for the messy parts of async UI: aborts, polling, transport fallback, TTL caching, storage and timers.",
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "composition-api",
    "async",
    "abortcontroller",
    "polling",
    "sse",
    "websocket",
    "typescript"
  ],
  "license": "MIT",
  "author": "Mykola Podpriatov <nsplotos@gmail.com>",
  "homepage": "https://github.com/mykolapodpriatov/vue-composables-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykolapodpriatov/vue-composables-kit.git"
  },
  "bugs": {
    "url": "https://github.com/mykolapodpriatov/vue-composables-kit/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepublishOnly": "pnpm run verify"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.13.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
